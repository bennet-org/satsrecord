{
  "name": "satsrecord",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @satsrecord/web dev",
    "build": "pnpm --filter @satsrecord/web build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "start": "node apps/web/server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3"
  }
}
