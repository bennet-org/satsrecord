---
export const prerender = false;
import { actions, isInputError } from 'astro:actions';
import Base from '../layouts/Base.astro';
import Header from '../components/marketing/Header.astro';
import { site } from '../data/marketing';
const result = Astro.getActionResult(actions.requestAccess);
const fieldErrors: Record<string, string[] | undefined> = isInputError(result?.error) ? result.error.fields : {};
---
<Base title={`Request access: ${site.name}`}>
  <Header />
  <main class="wrap">
    <div class="grid">
      <div>
        <h1>Request access.</h1>
        <p class="lead">Invite-only while we work with our first design partners. Tell us a little about your organisation and we will be in touch.</p>
        <p class="note">We use these details to reply to you and for nothing else.</p>
      </div>
      {result?.data?.ok ? (
        <div class="card">
          <b>Thanks. We have your request.</b>
          <p>We reply to every one, usually within a few days.</p>
          <a class="btn solid" href="/">Back to the site</a>
        </div>
      ) : (
        <form method="POST" action={actions.requestAccess} class="card">
          <label>Organisation <input name="organisation" required minlength="2" /><small>{fieldErrors.organisation?.[0]}</small></label>
          <label>Website <input name="website" type="url" placeholder="https://" /></label>
          <label>Your name <input name="name" required minlength="2" /><small>{fieldErrors.name?.[0]}</small></label>
          <label>Email <input name="email" type="email" required /><small>{fieldErrors.email?.[0]}</small></label>
          <label>Where are you registered?
            <select name="country" required>
              <option value="GB">United Kingdom</option>
              <option value="US">United States</option>
              <option value="EU">EU member state</option>
              <option value="other">Somewhere else</option>
            </select>
          </label>
          <label>Anything else <textarea name="message" rows="4" placeholder="How you take bitcoin today, what you would want from this, anything at all."></textarea></label>
          {result?.error && !isInputError(result.error) && <p class="err">Something went wrong. Please try again.</p>}
          <button class="btn solid" type="submit">Send request</button>
        </form>
      )}
    </div>
  </main>
</Base>
<style>
  main { padding-block: clamp(40px, 5vw, 72px) 80px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  h1 { font-size: clamp(44px, 6vw, 88px); line-height: 0.95; }
  .lead { font-size: clamp(18px, 1.5vw, 22px); line-height: 1.35; margin-top: 28px; max-width: 24em; }
  .note { margin-top: 16px; font-size: 14px; }
  .card { background: var(--color-paper); color: var(--color-paper-ink); border: 2px solid var(--color-ink); box-shadow: 10px 10px 0 var(--color-ink); padding: 28px; display: grid; gap: 18px; }
  .card b { font-size: 24px; font-weight: 800; letter-spacing: -0.02em; }
  label { display: grid; gap: 6px; font-size: 14px; font-weight: 700; }
  input, select, textarea { font: inherit; font-weight: 500; padding: 11px 12px; border: 2px solid var(--color-ink); background: #fff; color: var(--color-ink); border-radius: 0; }
  small { color: #A3341A; font-weight: 500; min-height: 1em; }
  .err { color: #A3341A; }
  button { justify-self: start; cursor: pointer; }
  .btn.solid { background: var(--color-ink); color: var(--color-paper); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; gap: 36px; } }
</style>
