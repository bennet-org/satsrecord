---
import App from "../../../layouts/App.astro";
import DonationTable from "../../../components/DonationTable.astro";
import { listDonations, donorsByIds } from "@satsrecord/core";
import { db, crypto } from "../../../lib/services";
const org = Astro.locals.org!;
const rows = await listDonations(db, org.id);
const donors = await donorsByIds(
  db,
  crypto(),
  org.id,
  rows.map((r) => r.donorId),
);
---

<App
  title="Donations"
  heading="Donations."
  intro="Each payment has its own settlement, valuation and acknowledgement record."
>
  <p>
    <a href="/app/exports?download=donations">Download donations CSV</a>
  </p>
  <DonationTable rows={rows} donors={donors} />
</App>
