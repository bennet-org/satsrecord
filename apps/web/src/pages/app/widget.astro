---
import App from "../../layouts/App.astro";
import {
  getSetup,
  widgetDefaults,
  widgetPresets,
  saveWidgetConfig,
  widgetSnippet,
  OnboardingError,
  type WidgetConfig,
} from "@satsrecord/core";
import { db, appUrl } from "../../lib/services";
const org = Astro.locals.org!;
const setup = await getSetup(db, org.id);
if (!setup?.completedAt) return Astro.redirect("/app/setup");
let config = { ...widgetDefaults, ...setup.widgetConfig };
let error = "";
const inline = Astro.request.headers.get("accept") === "application/json";
if (Astro.request.method === "POST") {
  if (Astro.request.headers.get("origin") !== Astro.url.origin)
    return new Response("Invalid origin", { status: 403 });
  try {
    const form = await Astro.request.formData();
    const input = Object.fromEntries(
      Object.keys(widgetDefaults).map((k) => [
        k,
        String(form.get(k) ?? widgetDefaults[k as keyof WidgetConfig]),
      ]),
    ) as WidgetConfig;
    await saveWidgetConfig(db, org.id, org.role, input);
    if (inline)
      return Response.json(
        { snippet: widgetSnippet(appUrl, org.id, input) },
        { headers: { "Cache-Control": "no-store" } },
      );
    return Astro.redirect("/app/widget", 303);
  } catch (e) {
    if (!(e instanceof OnboardingError)) throw e;
    error = e.message;
    if (inline)
      return Response.json(
        { error },
        { status: 400, headers: { "Cache-Control": "no-store" } },
      );
  }
}
---

<App
  title="Widget"
  heading="Make it yours."
  intro="Choose a style, add your words, and make giving feel at home on your website."
>
  {error && (
    <p class="error notice" role="alert">
      {error}
    </p>
  )}
  <div class="columns">
    <section class="panel">
      <h2>Customisation</h2>
      <form method="POST" class="form" id="widget-config">
        <fieldset disabled={!["owner", "admin"].includes(org.role)}>
          <div class="presets" role="group" aria-label="Widget style">
            {widgetPresets.map((preset) => (
              <label class={`preset-choice ${preset}`}>
                <input
                  type="radio"
                  name="preset"
                  value={preset}
                  checked={config.preset === preset}
                />
                <span class="swatch" aria-hidden="true">
                  Aa <i>↗</i>
                </span>
                <strong>
                  {preset === "satsrecord"
                    ? "SatsRecord"
                    : preset === "minimal"
                      ? "Minimal"
                      : "Editorial"}
                </strong>
                <small>
                  {preset === "satsrecord"
                    ? "Warm & direct"
                    : preset === "minimal"
                      ? "Quiet & simple"
                      : "Considered & classic"}
                </small>
              </label>
            ))}
          </div>
          {(
            [
              ["heading", "Heading", 100],
              ["button", "Button label", 60],
              ["consent", "Marketing opt-in label", 300],
            ] as const
          ).map(([key, label, max]) => (
            <label>
              {label}
              <input name={key} value={config[key]} required maxlength={max} />
            </label>
          ))}
          <button class="btn ink" id="save-widget" aria-live="polite">
            Save customisation
          </button>
          <span
            id="save-status"
            class="save-error"
            role="status"
            aria-live="polite"
          ></span>
        </fieldset>
      </form>
    </section>
    <section class="panel">
      <div class="preview-heading">
        <h2>Live preview</h2>
        <select id="preview-state" aria-label="Preview step">
          <option value="form">Donation form</option>
          <option value="address">Donation address</option>
          <option value="received">Received</option>
        </select>
      </div>
      <div class="preview-stage">
        <satsrecord-donate
          id="widget-preview"
          preview
          preset={config.preset}
          organisation={org.name}
        >
          <span slot="heading">{config.heading}</span>
          <span slot="button">{config.button}</span>
          <span slot="consent">{config.consent}</span>
        </satsrecord-donate>
      </div>
    </section>
  </div>
  <section class="panel">
    <h2>Install snippet</h2>
    <p>
      Save your changes, then place this snippet on an allowed website. Manage
      allowed websites in settings.
    </p>
    <textarea
      id="install-snippet"
      aria-label="Install snippet"
      readonly
      rows="9"
    >{widgetSnippet(appUrl,org.id,config)}</textarea>
    <button class="btn" type="button" id="copy-snippet">
      Copy snippet
    </button>
    <span
      id="copy-status"
      class="sr-only"
      role="status"
      aria-live="polite"
    ></span>
    <p class="mute">
      CSS variables: --sr-accent, --sr-background, --sr-text. Text slots:
      heading, button, consent.
    </p>
  </section>
</App>
<script is:inline src="/widget/v1.js" defer></script>
<script>
  const form = document.querySelector<HTMLFormElement>("#widget-config")!;
  const preview = document.querySelector<HTMLElement>("#widget-preview")!;
  const save = document.querySelector<HTMLButtonElement>("#save-widget")!;
  const status = document.querySelector<HTMLElement>("#save-status")!;
  const snippet =
    document.querySelector<HTMLTextAreaElement>("#install-snippet")!;
  let reset: ReturnType<typeof setTimeout>;
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    const body = new FormData(form);
    clearTimeout(reset);
    save.disabled = true;
    save.textContent = "Saving…";
    status.textContent = "";
    try {
      const response = await fetch(form.action, {
        method: "POST",
        body,
        headers: { Accept: "application/json" },
      });
      if (response.redirected)
        throw new Error(
          "Your session has expired. Reload and sign in to save.",
        );
      if (
        !(response.headers.get("content-type") ?? "").includes(
          "application/json",
        )
      )
        throw new Error("Could not save. Please try again.");
      const result = await response.json();
      if (!response.ok)
        throw new Error(result.error ?? "Could not save. Please try again.");
      snippet.value = result.snippet;
      save.textContent = "Done";
    } catch (error) {
      status.textContent =
        error instanceof Error
          ? error.message
          : "Could not save. Please try again.";
      save.textContent = "Try again";
    } finally {
      save.disabled = false;
      reset = setTimeout(() => {
        save.textContent = "Save customisation";
      }, 2000);
    }
  });
  let copyReset: ReturnType<typeof setTimeout>;
  document
    .querySelector<HTMLButtonElement>("#copy-snippet")!
    .addEventListener("click", async () => {
      const status = document.querySelector<HTMLElement>("#copy-status")!;
      try {
        await navigator.clipboard.writeText(snippet.value);
        const button =
          document.querySelector<HTMLButtonElement>("#copy-snippet")!;
        button.textContent = "Copied";
        status.textContent = "Snippet copied.";
        clearTimeout(copyReset);
        copyReset = setTimeout(() => {
          button.textContent = "Copy snippet";
        }, 2000);
      } catch {
        snippet.focus();
        snippet.select();
        status.textContent = "Select and copy the snippet above.";
      }
    });
  document
    .querySelector("#preview-state")!
    .addEventListener("change", (event) => {
      preview.setAttribute(
        "preview-state",
        (event.target as HTMLSelectElement).value,
      );
    });
  form.addEventListener("input", () => {
    const data = new FormData(form);
    preview.setAttribute("preset", String(data.get("preset")));
    for (const key of ["heading", "button", "consent"])
      preview.querySelector(`[slot="${key}"]`)!.textContent = String(
        data.get(key),
      );
    preview.setAttribute(
      "preview-state",
      String(
        (document.querySelector("#preview-state") as HTMLSelectElement).value,
      ),
    );
  });
</script>
<style>
  .save-error:empty {
    display: none;
  }
  .save-error {
    color: #a3341a;
  }
  #save-widget {
    min-width: 210px;
  }
  #copy-snippet {
    min-width: 150px;
  }

  .columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    align-items: start;
  }
  fieldset {
    border: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    min-width: 0;
  }
  .presets {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }
  .preset-choice {
    position: relative;
    display: grid;
    gap: 8px;
    border: 1px solid #17171730;
    padding: 12px;
    cursor: pointer;
    border-radius: 6px;
  }
  .preset-choice:has(input:checked) {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .preset-choice input {
    position: absolute;
    top: 12px;
    right: 12px;
    accent-color: var(--color-ink);
  }
  .preset-choice strong {
    font-size: 13px;
  }
  .preset-choice small {
    font-size: 11px;
    font-weight: 400;
    line-height: 1.4;
  }
  .swatch {
    display: flex;
    align-items: end;
    justify-content: space-between;
    height: 72px;
    padding: 10px;
    border: 1px solid #17171755;
    background: #fffaf3;
    font-size: 25px;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .swatch i {
    font-style: normal;
    background: #f7931a;
    font-size: 16px;
    line-height: 1;
    padding: 5px;
  }
  .minimal .swatch {
    background: white;
    border-radius: 8px;
    font-weight: 400;
  }
  .minimal .swatch i {
    background: #171717;
    color: white;
    border-radius: 4px;
  }
  .editorial .swatch {
    background: #f4f0e7;
    font-family: Georgia, serif;
    font-weight: 400;
    border: 0;
    border-top: 3px solid #171717;
  }
  .editorial .swatch i {
    background: #213e32;
    color: white;
  }
  .preview-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .preview-heading select {
    font-size: 12px;
    padding: 8px;
    border: 1px solid #17171740;
    background: white;
    border-radius: 4px;
  }
  .preview-stage {
    margin-top: 24px;
    padding: 20px 8px;
  }
  #widget-preview {
    margin: auto;
  }
  @media (max-width: 1100px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
  textarea {
    background: #fff;
    border: 2px solid var(--color-ink);
    margin-bottom: 12px;
    width: 100%;
    margin-top: 16px;
    font-family: monospace;
    font-size: 13px;
    padding: 14px;
  }
  @media (max-width: 700px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
