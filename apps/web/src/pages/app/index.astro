---
import App from "../../layouts/App.astro";
import {
  passkeysFor,
  getSetup,
  listDonations,
  listDonors,
  walletManifest,
} from "@satsrecord/core";
import { db, crypto } from "../../lib/services";
import DonationTable from "../../components/DonationTable.astro";
import BitcoinAmount from "../../components/BitcoinAmount.astro";
const { user, org } = Astro.locals;
if (
  Astro.cookies.get("passkey-prompt")?.value !== "skip" &&
  (await passkeysFor(db, user!.id)).length === 0
)
  return Astro.redirect("/app/welcome");
const setup = await getSetup(db, org!.id);
if (!setup?.completedAt) return Astro.redirect("/app/setup");
const [rows, donors, wallets] = await Promise.all([
  listDonations(db, org!.id),
  listDonors(db, crypto(), org!.id),
  walletManifest(db, org!.id),
]);
---

<App
  title="Dashboard"
  heading={org!.name}
  intro="Your bitcoin donation records."
>
  <div class="summary">
    <section class="panel">
      <h2>Donations</h2>
      <p class="number">{rows.length}</p>
      <a href="/app/donations">View all donations →</a>
    </section>
    <section class="panel">
      <h2>Confirmed bitcoin</h2>
      <div class="unit-toggle" role="group" aria-label="Bitcoin display unit">
        {["sats", "BTC"].map((unit) => (
          <button
            type="button"
            data-bitcoin-unit={unit}
            aria-pressed={
              (Astro.cookies.get("bitcoin-unit")?.value === "BTC"
                ? "BTC"
                : "sats") === unit
            }
          >
            {unit}
          </button>
        ))}
      </div>
      <p class="number">
        <BitcoinAmount
          amount={rows
            .filter((r) => r.settlement.status === "confirmed")
            .reduce((sum, r) => sum + r.settlement.amountSats, 0)}
        />
      </p>
      <p class="mute">Pending payments excluded.</p>
    </section>
    <section class="panel">
      <h2>Donor records</h2>
      <p class="number">{donors.length}</p>
      <a href="/app/donors">View donors →</a>
    </section>
  </div>
  <section class="panel">
    <h2>Recent donations</h2>
    <DonationTable rows={rows.slice(0, 10)} donors={donors} />
  </section>
  <section class="panel">
    <h2>Wallet recovery</h2>
    {wallets.map((w) => (
      <p>
        Wallet {w.label}: set your gap limit to at least{" "}
        <strong>{w.gapLimit}</strong>.
      </p>
    ))}
    <p>
      <a href="/app/exports">Download your address manifest →</a>
    </p>
  </section>
</App>
<style>
  .unit-toggle {
    display: flex;
    gap: 0;
    margin-bottom: 12px;
  }
  .unit-toggle button {
    border: 1px solid;
    padding: 4px 10px;
    font-size: 13px;
    cursor: pointer;
  }
  .unit-toggle button[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .summary {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .number {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  @media (max-width: 700px) {
    .summary {
      grid-template-columns: 1fr;
    }
  }
</style>
