---
import App from "../../layouts/App.astro";
import {
  passkeysFor,
  getSetup,
  listDonations,
  donorsByIds,
  donationTotals,
  walletGapLimits,
} from "@satsrecord/core";
import { db, crypto } from "../../lib/services";
import DonationTable from "../../components/DonationTable.astro";
import BitcoinAmount from "../../components/BitcoinAmount.astro";
const { user, org } = Astro.locals;
if (
  Astro.cookies.get("passkey-prompt")?.value !== "skip" &&
  (await passkeysFor(db, user!.id)).length === 0
)
  return Astro.redirect("/app/welcome");
const setup = await getSetup(db, org!.id);
if (!setup?.completedAt) return Astro.redirect("/app/setup");
const [totals, rows, wallets] = await Promise.all([
  donationTotals(db, org!.id),
  listDonations(db, org!.id, { limit: 10 }),
  walletGapLimits(db, org!.id),
]);
const donors = await donorsByIds(
  db,
  crypto(),
  org!.id,
  rows.map((r) => r.donorId),
);
---

<App
  title="Dashboard"
  heading={org!.name}
  intro="Your bitcoin donation records."
>
  <div class="summary">
    <section class="panel">
      <h2>Donations</h2>
      <p class="number">{totals.count}</p>
      <a href="/app/donations">View all donations →</a>
    </section>
    <section class="panel">
      <h2>Confirmed bitcoin</h2>
      <div class="amount-row">
        <p class="number">
          <BitcoinAmount amount={totals.confirmedSats} />
        </p>
        <div class="unit-toggle" role="group" aria-label="Bitcoin display unit">
          {["sats", "BTC"].map((unit) => (
            <button
              type="button"
              data-bitcoin-unit={unit}
              aria-pressed={
                (Astro.cookies.get("bitcoin-unit")?.value === "BTC"
                  ? "BTC"
                  : "sats") === unit
              }
            >
              {unit}
            </button>
          ))}
        </div>
      </div>
      <p class="mute">Pending payments excluded.</p>
    </section>
  </div>
  <section class="panel">
    <h2>Recent donations</h2>
    <DonationTable rows={rows} donors={donors} />
  </section>
  <section class="panel">
    <h2>Wallet recovery</h2>
    {wallets.map((w) => (
      <p>
        Wallet {w.label}: set your gap limit to at least{" "}
        <strong>{w.gapLimit}</strong>.
      </p>
    ))}
    <p>
      <a href="/app/exports">Download your address manifest →</a>
    </p>
  </section>
</App>
<style>
  .amount-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 12px;
    margin-bottom: 10px;
  }
  .amount-row .number {
    margin-bottom: 0;
    overflow-wrap: anywhere;
  }
  .unit-toggle {
    justify-self: end;
    margin-top: 5px;
    display: flex;
    gap: 0;
    flex-shrink: 0;
    border: 1px solid var(--color-ink);
  }
  .unit-toggle button {
    border: 0;
    padding: 5px 9px;
    font-size: 13px;
    line-height: 1.4;
    cursor: pointer;
  }
  .unit-toggle button[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .number {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 10px;
  }
  @media (max-width: 700px) {
    .summary {
      grid-template-columns: 1fr;
    }
  }
</style>
