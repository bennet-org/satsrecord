---
import { site, closing } from "../../data/marketing";
---

<section class="close wrap">
  <h2>{site.spine}</h2>
  <div class="row">
    <p>{closing.body}</p>
    <a class="btn paper" href="/request-access">
      Request access
    </a>
  </div>
  <footer>
    <span>
      {site.name} · {site.descriptor.replace(/\.$/, "")}
    </span>
    <span>
      {closing.legal} · {site.domain}
    </span>
  </footer>
</section>
<style>
  .close {
    background: var(--color-ink);
    color: var(--color-ground);
    padding-block: clamp(56px, 6.1vw, 88px) 36px;
  }
  h2 {
    font-size: clamp(40px, 6.7vw, 96px);
    line-height: 0.92;
    max-width: 10em;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 48px;
    gap: 40px;
    flex-wrap: wrap;
  }
  p {
    font-size: 19px;
    line-height: 1.4;
    max-width: 30em;
  }
  footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: clamp(48px, 5.5vw, 80px);
    padding-top: 16px;
    border-top: 2px solid var(--color-ground);
    font-size: 13px;
  }
</style>
