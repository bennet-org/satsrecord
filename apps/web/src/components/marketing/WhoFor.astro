---
import { whoFor } from '../../data/marketing';
---
<section class="band wrap">
  <div class="two">
    <h2 class="h2">{whoFor.heading}</h2>
    <div>
      <p class="lead">{whoFor.body}</p>
      <div class="rule"></div>
      <dl class="roles">
        {whoFor.roles.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
      </dl>
    </div>
  </div>
</section>
<style>
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .lead { font-size: clamp(17px, 1.4vw, 20px); line-height: 1.4; }
  .rule { border-top: 2px solid var(--color-paper-ink); margin: 28px 0 20px; }
  .roles { display: grid; grid-template-columns: auto 1fr; gap: 10px 16px; font-size: 16px; margin: 0; }
  dt { font-weight: 800; }
  dd { margin: 0; }
  @media (max-width: 900px) { .two { grid-template-columns: 1fr; gap: 36px; } }
</style>
