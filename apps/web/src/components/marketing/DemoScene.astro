---
import { bitcoinQR } from "../../../../../packages/widget/src/qr";
import { sampleRecord } from "../../data/marketing";
interface Props {
  scene: number;
}
const { scene } = Astro.props;
const amount = sampleRecord.rows[2]![1];
const value = sampleRecord.rows[3]![1];
// Frame start times in ms; the last entry is the loop length.
const timelines = [
  [2800, 5800],
  [500, 1300, 1500, 4300, 6800],
  [400, 1500, 2500, 3300, 3500, 6000],
];
// Shown without JS or with reduced motion.
const stills = [1, 3, 2];
const snippet: Array<Array<[string, Array<[string, string]>]>> = [
  [
    ["", [["t", "<script"]]],
    [" ", [["a", "defer"]]],
    [
      " ",
      [
        ["a", "src"],
        ["", "="],
        ["s", '"https://satsrecord.org/widget/v1.js"'],
      ],
    ],
    ["", [["t", "></script>"]]],
  ],
  [
    ["", [["t", "<satsrecord-donate"]]],
    [
      " ",
      [
        ["a", "org"],
        ["", "="],
        ["s", '"harbour-aid"'],
      ],
    ],
    ["", [["t", "></satsrecord-donate>"]]],
  ],
];
// BIP84 test-vector address with its last checksum character deliberately changed.
// It has no valid Bitcoin destination. The displayed address and QR must match.
const demoAddress = "bc1qcr8te4kr609gcawutmrza0j4xv80jy8z306fyq";
const descriptions = [
  "The installation snippet becomes the donation widget.",
  "A donor asks for a donation address, receives a fresh Bitcoin address, and sees their donation detected.",
  `The same ${amount} donation confirms, is valued at ${value}, acknowledged and exported as CSV.`,
];
---

<figure
  class="demo-visual"
  data-scene={scene}
  data-frame={stills[scene]}
  data-timeline={timelines[scene]!.join()}
>
  {scene === 2 && (
    <div class="demo-chrome">
      <span>HARBOUR AID</span>
      <span>YOUR RECORDS</span>
    </div>
  )}
  <div class="demo-stage" role="img" aria-label={descriptions[scene]}>
    <div aria-hidden="true" class="scene-content">
      {scene < 2 ? (
        <div class="widget-demo">
          {scene === 0 && (
            <code class="snippet">
              {snippet.map((line) => (
                <span>
                  {line.map(([separator, parts], i) => (
                    <>
                      {i > 0 && (separator || <wbr />)}
                      <span>
                        {parts.map(([kind, text]) =>
                          kind ? <span class={kind}>{text}</span> : text,
                        )}
                      </span>
                    </>
                  ))}
                </span>
              ))}
            </code>
          )}
          <div class="widget-inner">
            <div class="demo-screen" data-screen="form">
              <h3>Donate bitcoin</h3>
              <p class="widget-description">
                Support our work with a bitcoin donation.
              </p>
              <div class="mock-field">
                <span>
                  Name <small>Optional</small>
                </span>
                <div class:list={{ placeholder: scene === 0 }}>
                  {scene === 0 ? "Your name" : "A. Donor"}
                </div>
              </div>
              <div class="mock-field">
                <span>
                  Email <small>Optional</small>
                </span>
                <div class:list={{ placeholder: scene === 0 }}>
                  {scene === 0 ? "you@example.org" : "donor@example.org"}
                </div>
              </div>
              <p class="mock-consent">
                <span></span> Keep me updated by email.
              </p>
              <span class="demo-button give-button">
                Get donation address
                {scene === 1 && (
                  <svg class="demo-cursor" viewBox="0 0 17 22">
                    <path d="M1.5 1.5V19l12-5.5z" />
                  </svg>
                )}
              </span>
            </div>
            {scene === 1 && (
              <>
                <div class="demo-screen" data-screen="address">
                  <h3>Your donation address.</h3>
                  <div
                    class="sample-qr"
                    set:html={bitcoinQR(`bitcoin:${demoAddress}`)}
                  />
                  <code class="sample-address">{demoAddress}</code>
                  <div class="address-actions">
                    <span class="demo-button">Copy address</span>
                    <span class="outline-button">Open in wallet ↗</span>
                  </div>
                  <p class="screen-note">Demo address · payments disabled.</p>
                </div>
                <div class="demo-screen" data-screen="received">
                  <h3>Received, thank you.</h3>
                  <div class="received-tick">✓</div>
                  <p>
                    Your bitcoin donation has been detected. Thank you for
                    supporting Harbour Aid.
                  </p>
                </div>
              </>
            )}
            <div class="widget-brand">
              Powered by
              <b>
                <svg viewBox="2 2 28 28">
                  <rect
                    x="6"
                    y="6"
                    width="24"
                    height="24"
                    fill="currentColor"
                  />
                  <rect
                    x="3"
                    y="3"
                    width="22"
                    height="22"
                    fill="var(--color-paper)"
                    stroke="currentColor"
                    stroke-width="2"
                  />
                  <rect x="7" y="9" width="14" height="3" fill="currentColor" />
                </svg>
                SatsRecord
              </b>
            </div>
          </div>
        </div>
      ) : (
        <div class="records-demo">
          <div class="donation-list">
            <div class="list-head">
              <span>Donor / amount</span>
              <span>Value / status</span>
            </div>
            <div class="new-gift">
              <div class="gift-row">
                <div>
                  <b>A. Donor</b>
                  <span>{amount}</span>
                </div>
                <div>
                  <b>
                    <span class="pending">TBC</span>
                    <span class="confirmed">{value}</span>
                  </b>
                  <span>
                    <span class="pending">Pending</span>
                    <span class="confirmed">Confirmed ✓</span>
                  </span>
                </div>
              </div>
            </div>
            <div class="older-row">
              <span>Anonymous</span>
              <span>Confirmed</span>
            </div>
            <div class="older-row">
              <span>B. Donor</span>
              <span>Confirmed</span>
            </div>
          </div>
          <div class="record-detail">
            <span>
              Value at block time <b>{value}</b>
            </span>
            <span>
              Price source <b>Kraken XBT/USD</b>
            </span>
            <span>
              Acknowledgement <b>Sent ✓</b>
            </span>
          </div>
          <span class="demo-button export-button">
            <span class="before-download">Download donations CSV ↓</span>
            <span class="after-download">Downloaded ✓</span>
            <svg class="demo-cursor" viewBox="0 0 17 22">
              <path d="M1.5 1.5V19l12-5.5z" />
            </svg>
          </span>
        </div>
      )}
    </div>
  </div>
</figure>

<style>
  .demo-visual {
    margin: 0;
    min-width: 0;
    width: 100%;
    color: var(--color-ink);
    --snippet-height: 116px;
  }
  .demo-visual[data-scene="2"] {
    background: var(--color-paper);
    border: 2px solid var(--color-ink);
    box-shadow: 8px 8px 0 var(--color-ink);
  }
  .demo-chrome {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--color-ink);
    padding: 15px 22px;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  /* Scenes 01 and 02 match the height of 03's frame. */
  .demo-stage {
    height: 550px;
    position: relative;
  }
  [data-scene="2"] .demo-stage {
    height: 500px;
  }
  .scene-content {
    height: 100%;
    position: relative;
  }
  .demo-cursor {
    position: absolute;
    left: 58%;
    top: 50%;
    width: 20px;
    height: 26px;
    margin: -1.75px 0 0 -1.75px;
    transform-origin: 1.75px 1.75px;
    pointer-events: none;
  }
  .demo-cursor path {
    fill: var(--color-ink);
    stroke: white;
    stroke-width: 1.5;
  }

  /* 01: the snippet box becomes the widget */
  [data-scene="0"] .widget-demo {
    transition-property: top, right, bottom, left;
    transition-duration: 0.6s;
    transition-delay: 0.15s;
    transition-timing-function: cubic-bezier(0.65, 0, 0.25, 1);
  }
  [data-scene="0"][data-frame="0"] .widget-demo {
    top: calc(50% - var(--snippet-height) / 2);
    right: 5px;
    bottom: calc(50% - var(--snippet-height) / 2);
    left: 0;
    transition-duration: 0.5s;
    transition-delay: 0.1s;
  }
  .snippet {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    padding-inline: 24px;
    font:
      13px/22px ui-monospace,
      monospace;
    transition: opacity 0.2s 0.5s;
  }
  .snippet > span {
    padding-left: 2ch;
    text-indent: -2ch;
  }
  .snippet > span > span {
    white-space: nowrap;
  }
  .snippet .a {
    color: var(--color-paper-mute);
  }
  .snippet .s {
    color: #9e4100;
  }
  [data-scene="0"][data-frame="1"] .snippet {
    opacity: 0;
    transition: opacity 0.15s;
  }
  [data-scene="0"] .widget-inner {
    transition: opacity 0.3s 0.65s;
  }
  [data-scene="0"][data-frame="0"] .widget-inner {
    opacity: 0;
    transition: opacity 0.15s;
  }

  /* widget */
  .widget-demo {
    position: absolute;
    top: 40px;
    right: calc(50% - 210px);
    bottom: 40px;
    left: calc(50% - 210px);
    background: var(--color-paper);
    border: 2px solid var(--color-ink);
    box-shadow: 5px 5px 0 var(--color-ink);
  }
  .widget-inner {
    height: 100%;
  }
  .demo-screen {
    position: absolute;
    inset: 0 0 38px;
    padding: 28px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease,
      visibility 0s 0.3s;
  }
  [data-scene="0"] [data-screen="form"],
  [data-scene="1"]:is([data-frame="0"], [data-frame="1"], [data-frame="2"])
    [data-screen="form"],
  [data-scene="1"][data-frame="3"] [data-screen="address"],
  [data-scene="1"][data-frame="4"] [data-screen="received"] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  h3 {
    font-size: 32px;
    line-height: 1.06;
  }
  .widget-description {
    font-size: 13px;
    padding-block: 12px 18px;
    border-bottom: 2px solid var(--color-ink);
    margin-bottom: 18px;
  }
  .mock-field {
    margin-bottom: 14px;
    font-size: 13px;
  }
  .mock-field > span {
    font-weight: 700;
    display: block;
    margin-bottom: 4px;
  }
  .mock-field small {
    font-weight: 500;
    color: var(--color-paper-mute);
  }
  .mock-field > div {
    background: white;
    border: 1px solid var(--color-ink);
    padding: 10px;
  }
  .placeholder {
    color: var(--color-paper-mute);
  }
  .mock-consent {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    margin-block: 14px 18px;
  }
  .mock-consent span {
    width: 13px;
    height: 13px;
    border: 1px solid;
  }
  .demo-button,
  .outline-button {
    display: block;
    position: relative;
    background: var(--color-ground);
    border: 2px solid var(--color-ink);
    text-align: center;
    padding: 12px 10px;
    font-size: 14px;
    font-weight: 800;
    transition: background-color 0.1s;
  }
  .outline-button {
    background: transparent;
  }
  .widget-brand {
    position: absolute;
    bottom: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 5px;
    border-top: 1px solid var(--color-paper-hair);
    height: 38px;
    font-size: 11px;
  }
  .widget-brand b {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .widget-brand svg {
    width: 15px;
    height: 15px;
  }

  /* 02: the donor clicks through to an address */
  [data-scene="1"] .demo-cursor {
    transform: translate(70px, 56px);
  }
  [data-scene="1"][data-frame="1"] .demo-cursor {
    transform: none;
    transition: transform 0.7s cubic-bezier(0.45, 0, 0.2, 1);
  }
  [data-scene="1"][data-frame="2"] .demo-cursor {
    transform: scale(0.85);
    transition: transform 0.1s;
  }
  [data-scene="1"]:is([data-frame="3"], [data-frame="4"]) .demo-cursor {
    transform: none;
  }
  [data-scene="1"][data-frame="2"] .give-button {
    background: color-mix(in srgb, var(--color-ground) 78%, var(--color-ink));
  }
  .sample-qr {
    width: 164px;
    height: 164px;
    margin: 18px auto 12px;
  }
  .sample-qr :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .sample-address {
    display: block;
    text-align: center;
    font-size: 12px;
    overflow-wrap: anywhere;
    margin-bottom: 16px;
  }
  .address-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .address-actions > span {
    font-size: 11px;
    padding: 10px 4px;
  }
  .screen-note {
    font-size: 12px;
    text-align: center;
    margin-top: 12px;
  }
  .received-tick {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin: 24px 0 18px;
    border: 2px solid;
    background: var(--color-ground);
    font-size: 26px;
  }
  [data-screen="received"] p {
    font-size: 14px;
  }

  /* 03: the gift confirms and is exported */
  .records-demo {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px;
  }
  .donation-list {
    font-size: 13px;
  }
  .list-head,
  .gift-row,
  .older-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .list-head {
    border-bottom: 2px solid;
    font-size: 11px;
    padding-bottom: 8px;
  }
  .new-gift {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.65, 0, 0.25, 1);
  }
  [data-scene="2"][data-frame="0"] .new-gift {
    grid-template-rows: 0fr;
  }
  .gift-row {
    overflow: hidden;
    min-height: 0;
    background: #f7931a26;
    padding-inline: 10px;
    border-bottom: 1px solid var(--color-paper-hair);
  }
  .gift-row > div {
    display: grid;
    gap: 3px;
    padding-block: 14px;
  }
  .gift-row > div + div {
    text-align: right;
  }
  .gift-row b {
    font-size: 18px;
  }
  .gift-row div > span {
    font-size: 12px;
  }
  .pending,
  [data-scene="2"][data-frame="1"] .confirmed {
    display: none;
  }
  [data-scene="2"][data-frame="1"] .pending {
    display: inline;
  }
  .older-row {
    color: var(--color-paper-mute);
    font-size: 12px;
    padding: 11px 10px;
    border-bottom: 1px solid var(--color-paper-hair);
  }
  .record-detail {
    display: grid;
    gap: 10px;
    font-size: 13px;
    margin-top: 24px;
    transition: opacity 0.3s;
  }
  [data-scene="2"]:is([data-frame="0"], [data-frame="1"]) .record-detail {
    opacity: 0;
  }
  .record-detail > span {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .record-detail b {
    font-weight: 700;
  }
  .export-button {
    margin-top: auto;
    padding: 14px 10px;
    font-size: 14px;
  }
  .after-download,
  [data-scene="2"][data-frame="5"] .before-download {
    display: none;
  }
  [data-scene="2"][data-frame="5"] .after-download {
    display: inline;
  }
  [data-scene="2"][data-frame="4"] .export-button {
    background: color-mix(in srgb, var(--color-ground) 78%, var(--color-ink));
  }
  [data-scene="2"] .demo-cursor {
    opacity: 0;
    transform: translate(70px, -96px);
  }
  [data-scene="2"][data-frame="3"] .demo-cursor {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.2s,
      transform 0.7s cubic-bezier(0.45, 0, 0.2, 1);
  }
  [data-scene="2"][data-frame="4"] .demo-cursor {
    opacity: 1;
    transform: scale(0.85);
    transition: transform 0.1s;
  }
  [data-scene="2"][data-frame="5"] .demo-cursor {
    transform: none;
    transition: opacity 0.3s 0.4s;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
    }
  }
  @media (min-width: 901px) and (max-width: 1279px) {
    .demo-visual {
      --snippet-height: 160px;
    }
  }
  @media (min-width: 901px) and (max-width: 1099px) {
    .widget-demo {
      right: calc(50% - 190px);
      left: calc(50% - 190px);
    }
    h3 {
      font-size: 28px;
    }
  }
  @media (max-width: 600px) {
    .demo-visual {
      --snippet-height: 160px;
    }
    .demo-stage {
      height: 510px;
    }
    [data-scene="2"] .demo-stage {
      height: 480px;
    }
    .widget-demo {
      top: 20px;
      right: 5px;
      bottom: 20px;
      left: 0;
    }
    .snippet {
      padding-inline: 14px;
      font-size: 11px;
      line-height: 20px;
    }
    .demo-screen {
      padding: 22px 20px;
    }
    h3 {
      font-size: 26px;
    }
    .sample-address {
      font-size: 11px;
    }
    .records-demo {
      padding: 22px 18px;
    }
    .demo-chrome {
      padding-inline: 16px;
      font-size: 9px;
    }
  }
  @media (max-width: 360px) {
    .snippet {
      font-size: 9.5px;
    }
  }
</style>
