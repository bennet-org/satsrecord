---
import RecordCard from './RecordCard.astro';
import { hero, site } from '../../data/marketing';
---
<section class="hero wrap">
  <h1>{hero.headline}</h1>
  <div class="row">
    <div>
      <p class="sub">{hero.lead}</p>
      <div class="acts">
        <a class="btn solid" href="/request-access">Request access</a>
        <a class="btn" href={site.sourceUrl}>Read the source</a>
      </div>
    </div>
    <RecordCard />
  </div>
  <ul class="facts">
    {hero.facts.map((f) => <li><b>{f.title}</b><p>{f.body}</p></li>)}
  </ul>
</section>
<style>
  .hero { display: flex; flex-direction: column; min-height: min(calc(100vh - 76px), 900px); padding-bottom: 30px; }
  h1 { font-size: clamp(44px, 8.05vw, 116px); line-height: 0.98; margin-top: clamp(28px, 3.75vw, 54px); max-width: 9.4em; text-wrap: balance; }
  .row { display: grid; grid-template-columns: 1fr 440px; gap: 64px; margin: 44px 0 72px; align-items: end; }
  .sub { font-size: clamp(18px, 1.67vw, 24px); line-height: 1.3; max-width: 22em; }
  .acts { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; }
  .facts { margin-top: auto; padding-top: 44px; border-top: 2px solid var(--color-ink); display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px; }
  .facts b { display: block; font-size: 19px; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 6px; }
  .facts p { font-size: 15px; }
  @media (max-width: 1000px) {
    .row { grid-template-columns: 1fr; gap: 40px; margin-bottom: 56px; }
    .facts { grid-template-columns: 1fr 1fr; gap: 28px; }
  }
  @media (max-width: 560px) { .facts { grid-template-columns: 1fr; } }
</style>
