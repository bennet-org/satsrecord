---
import { site, nav } from '../../data/marketing';
---
<header class="wrap">
  <div class="bar">
    <a class="wm" href="/">{site.name}</a>
    <nav>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a class="cta" href="/request-access">Request access</a>
    </nav>
  </div>
</header>
<style>
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 26px 0 22px; border-bottom: 2px solid var(--color-ink); }
  .wm { font-weight: 800; font-size: 23px; letter-spacing: -0.03em; }
  nav { display: flex; gap: 28px; align-items: center; font-size: 15px; font-weight: 500; }
  .cta { background: var(--color-ink); color: var(--color-ground); padding: 10px 18px; font-weight: 700; }
  @media (max-width: 760px) { nav a:not(.cta) { display: none; } }
</style>
