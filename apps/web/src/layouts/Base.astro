---
import '../styles/global.css';
import { site } from '../data/marketing';
interface Props { title?: string; description?: string }
const { title = `${site.name}: ${site.descriptor.replace(/\.$/, '')}`, description = site.descriptor } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7931A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700;800&display=swap" />
  </head>
  <body>
    <slot />
  </body>
</html>
