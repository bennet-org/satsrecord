# For compose.production.yaml only. Copy to .env.production and chmod 600 it.
# Never commit the populated file. See docs/self-hosting.md.
# Generate the database password with: openssl rand -hex 32
# Hex avoids reserved URL characters in the app's database connection string.
POSTGRES_PASSWORD=
# Public HTTPS origin, with no path or trailing slash.
APP_URL=
# Generate EACH of these independently with: openssl rand -base64 32
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
INDEX_KEY=
# Resend is currently the supported delivery provider; SMTP is not implemented.
RESEND_API_KEY=
# Use an address on your verified sending domain, e.g. Your Charity <donations@example.org>
MAIL_FROM=
# Comma-separated operator addresses. Sign in at /login, then issue invites at /admin.
OPERATOR_EMAILS=
# Optional access-request alerts.
NOTIFY_EMAIL=
# Optional until scheduling notifications. Generate independently: openssl rand -base64 32
NOTIFICATION_CRON_SECRET=
