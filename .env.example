# apps/web reads these through astro:env (schema in apps/web/astro.config.ts)
DATABASE_URL=postgres://satsrecord:satsrecord@localhost:5432/satsrecord
# Leave RESEND_API_KEY unset to print mail to the console instead of sending
RESEND_API_KEY=
MAIL_FROM=SatsRecord <hello@satsrecord.org>
# Where access requests are announced. Unset means store only.
NOTIFY_EMAIL=
# Origin the app is served from; email links and passkeys depend on it
APP_URL=http://localhost:4321
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated. These accounts can issue organisation invites at /admin.
OPERATOR_EMAILS=
# Show sent mail at /dev/outbox (console mailer only; exposes sign-in links, so local only)
DEV_OUTBOX=false
OPEN_SIGNUP=false
SIMULATE_DONATIONS=false
# 32 random bytes each, base64, and different from each other. Required from Phase 3.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
INDEX_KEY=
